# GitHub OAuth (user login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# GitHub App — production webhooks, Checks API, PR comments
# See docs/PRODUCTION_GITHUB.md
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/github-app.pem
GITHUB_APP_SLUG=codelens
ENABLE_GITHUB_CHECKS=true
ENABLE_GITHUB_PR_COMMENTS=false
AUTO_POST_PR_COMMENT_ON_WEBHOOK=false

# Signed embed URLs (Check details + github.com iframe)
EMBED_SHARED_SECRET=
EMBED_ALLOWED_FRAME_ANCESTORS=https://github.com

# App
SESSION_SECRET=change-me-to-a-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
DATABASE_URL=sqlite+aiosqlite:///./app/db/codelens.db

# Docker Compose (docker compose up — app on http://localhost:8080):
# FRONTEND_URL=http://localhost:8080
# BACKEND_URL=http://localhost:8080
# GITHUB_REDIRECT_URI=http://localhost:8080/auth/github/callback

# Public dev tunnel (Cloudflare: scripts/cloudflared-tunnel.sh | localtunnel: npx localtunnel --port 5173)
# Then run: ./scripts/set-public-url.sh https://YOUR-PUBLIC-URL
# FRONTEND_URL=https://YOUR-ID.trycloudflare.com
# BACKEND_URL=https://YOUR-ID.trycloudflare.com
# GITHUB_REDIRECT_URI=https://YOUR-ID.trycloudflare.com/auth/github/callback
# Also set the same callback URL in your GitHub OAuth App settings.

# AI summaries — provider: openai | groq | perplexity | openrouter
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
---

CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
