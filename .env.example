# GitHub OAuth — create at https://github.com/settings/developers
# Callback URL (must match GitHub OAuth app + Vite proxy): http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# App
SESSION_SECRET=change-me-to-a-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# AI summaries — provider: openai | groq | perplexity | openrouter
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
# AI_BASE_URL=

# Legacy OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cursor API (slow fallback for executive summary only)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
